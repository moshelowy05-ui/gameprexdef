# ─────────────────────────────────────────────────────────────────────────────
# GamePrexDef — Environment Configuration
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=gameprex
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=gameprexdef

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_with_secrets_token_hex_32

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# For single-host deployments behind nginx, this can be left empty
# since the frontend and API are served from the same origin.
CORS_ORIGINS=

# ── Default Login Credentials ─────────────────────────────────────────────────
# Change these before going live. Users are stored in memory — anyone with
# these credentials can access the simulation.
DEFAULT_USERNAME=nca
DEFAULT_PASSWORD=change_me_strong_password

# ── Network ───────────────────────────────────────────────────────────────────
# Host port that nginx binds to (default 80)
BIND_PORT=80
